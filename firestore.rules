rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isTeacherFor(studentUid) {
      return exists(/databases/$(database)/documents/users/$(studentUid)) &&
             get(/databases/$(database)/documents/users/$(studentUid)).data.teacherId == request.auth.uid;
    }

    function isStudentOf(teacherUid) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teacherId == teacherUid;
    }

    function isOwnerOrTeacher(userId) {
      return request.auth.uid == userId || isTeacherFor(userId);
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isTeacherFor(userId));
      allow read: if isSignedIn(); // To allow users to find teachers by ID or allow teachers to see their students
    }

    match /muscle_groups/{groupId} {
      allow read, update, delete: if isSignedIn() && isOwnerOrTeacher(resource.data.userId);
      allow create: if isSignedIn() && isOwnerOrTeacher(request.resource.data.userId);
    }
    match /exercises/{exerciseId} {
      // Students can read exercises owned by their teacher
      allow read: if isSignedIn() && (isOwnerOrTeacher(resource.data.userId) || isStudentOf(resource.data.userId) || resource.data.userId == null);
      allow update, delete: if isSignedIn() && isOwnerOrTeacher(resource.data.userId);
      allow create: if isSignedIn() && isOwnerOrTeacher(request.resource.data.userId);
    }
    match /routines/{routineId} {
      // Students can read routines owned by their teacher (templates)
      allow read: if isSignedIn() && (isOwnerOrTeacher(resource.data.userId) || isStudentOf(resource.data.userId));
      allow update, delete: if isSignedIn() && isOwnerOrTeacher(resource.data.userId);
      allow create: if isSignedIn() && isOwnerOrTeacher(request.resource.data.userId);
    }
    match /workouts/{workoutId} {
      allow read, update, delete: if isSignedIn() && isOwnerOrTeacher(resource.data.userId);
      allow create: if isSignedIn() && isOwnerOrTeacher(request.resource.data.userId);
    }
    match /user_goals/{userId} {
      allow read, write: if isSignedIn() && isOwnerOrTeacher(userId);
    }
  }
}
